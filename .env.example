# ============================================================================
# StuDy AI - Production Environment Variables Template (.env)
# ============================================================================
# Copy this file to .env on your VPS:
# cp .env.example .env

# Security
# Generate a secure 50+ character key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace_with_a_secure_random_key_min_50_chars_for_production_2026

# Set to False in production
DEBUG=False

# Your VPS IP or Domain (comma-separated, without spaces or trailing slashes)
# Example: ALLOWED_HOSTS=123.45.67.89,study.uz,www.study.uz
ALLOWED_HOSTS=*

# Trusted origins for CSRF POST requests (comma-separated, with scheme)
# Example: CSRF_TRUSTED_ORIGINS=https://study.uz,http://123.45.67.89
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database (used if running without Docker or customizing Docker)
POSTGRES_DB=study_db
POSTGRES_USER=study_user
POSTGRES_PASSWORD=study_secure_password_2026

# Database & Redis URLs (automatically configured in docker-compose)
DATABASE_URL=postgresql://study_user:study_secure_password_2026@db:5432/study_db
REDIS_URL=redis://redis:6379/0
USE_CELERY=True
