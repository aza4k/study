# ============================================================================
# StuDy AI - Production Environment Variables Template (.env)
# ============================================================================
# Copy this file to .env on your server:
# cp .env.example .env

# Server port (default: 8001)
STUDY_PORT=8001

# Security Key
SECRET_KEY=your_strong_random_secret_key_here

# Production Mode
DEBUG=False

# Allowed Hostnames / Domains / IPs
ALLOWED_HOSTS=*

# Trusted Origins for CSRF
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://127.0.0.1:8001

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Database Configuration
POSTGRES_DB=study_db
POSTGRES_USER=study_user
POSTGRES_PASSWORD=your_db_password_here

# Database & Redis URLs
DATABASE_URL=postgresql://study_user:your_db_password_here@127.0.0.1:5432/study_db
REDIS_URL=redis://127.0.0.1:6379/0
USE_CELERY=True
